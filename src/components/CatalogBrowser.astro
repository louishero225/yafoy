---
import ProductCard from './ProductCard.astro';
import Icon from './Icon.astro';
import { FAMILIES, type Product } from '../lib/catalog';

interface Props {
  products: Product[];
  /** Affiche le filtre par famille (catalogue complet uniquement). */
  showFamilies?: boolean;
}
const { products, showFamilies = false } = Astro.props;

const count = (fn: (p: Product) => string | null) => {
  const m = new Map<string, number>();
  for (const p of products) {
    const k = fn(p);
    if (k) m.set(k, (m.get(k) ?? 0) + 1);
  }
  return [...m.entries()].sort((a, b) => a[0].localeCompare(b[0], 'fr'));
};
const origins = count((p) => p.country);
const categories = count((p) => p.category);
const families = FAMILIES.map((f) => ({ ...f, n: products.filter((p) => p.familyHandle === f.handle).length })).filter((f) => f.n > 0);
---
<section class="catalog container" data-catalog data-page-size="48" aria-label="Catalogue">
  <button class="btn btn--ghost btn--sm filters-toggle" type="button" data-filters-toggle aria-expanded="false" aria-controls="filters">
    <Icon name="filter" /> Filtres
  </button>

  <form class="filters" id="filters" data-filters role="search" autocomplete="off" onsubmit="return false">
    <div class="field">
      <label for="f-q">Rechercher</label>
      <input id="f-q" name="q" type="search" placeholder="Nom, origine, type…" />
    </div>

    {showFamilies && (
      <fieldset class="field">
        <legend>Famille</legend>
        <div class="pills">
          <label class="pill"><input type="radio" name="famille" value="" checked /><span>Toutes <em>{products.length}</em></span></label>
          {families.map((f) => (
            <label class="pill"><input type="radio" name="famille" value={f.handle} /><span>{f.label} <em>{f.n}</em></span></label>
          ))}
        </div>
      </fieldset>
    )}

    {origins.length > 1 && (
      <div class="field">
        <label for="f-origine">Origine</label>
        <select id="f-origine" name="origine">
          <option value="">Toutes les origines</option>
          {origins.map(([o, n]) => <option value={o}>{o} ({n})</option>)}
        </select>
      </div>
    )}

    {categories.length > 1 && (
      <div class="field">
        <label for="f-type">Type</label>
        <select id="f-type" name="type">
          <option value="">Tous les types</option>
          {categories.map(([c, n]) => <option value={c}>{c} ({n})</option>)}
        </select>
      </div>
    )}

    <fieldset class="field">
      <legend>Prix du carton (FCFA)</legend>
      <div class="range">
        <input name="min" type="number" inputmode="numeric" min="0" step="1000" placeholder="Min" aria-label="Prix minimum" />
        <span aria-hidden="true">–</span>
        <input name="max" type="number" inputmode="numeric" min="0" step="1000" placeholder="Max" aria-label="Prix maximum" />
      </div>
    </fieldset>

    <label class="switch">
      <input type="checkbox" name="stock" value="1" />
      <span class="switch__track" aria-hidden="true"></span>
      <span>En stock uniquement</span>
    </label>

    <button class="reset" type="button" data-reset>Réinitialiser les filtres</button>
  </form>

  <div class="results">
    <div class="results__bar">
      <p class="results__count" role="status" aria-live="polite"><strong data-count>{products.length}</strong> <span data-count-label>produits</span></p>
      <div class="sort">
        <label for="f-tri">Trier par</label>
        <select id="f-tri" name="tri" form="filters">
          <option value="nom">Nom (A–Z)</option>
          <option value="prix-asc">Prix croissant</option>
          <option value="prix-desc">Prix décroissant</option>
          <option value="nouveautes">Nouveautés</option>
        </select>
      </div>
    </div>

    <div class="product-grid" data-grid>
      {products.map((p, i) => <ProductCard product={p} filterable priority={i < 4} headingLevel={2} />)}
    </div>

    <p class="empty" data-empty hidden>
      Aucun produit ne correspond à votre recherche.
      <button type="button" class="link-arrow" data-reset>Réinitialiser les filtres</button>
    </p>
    <div class="more"><button class="btn btn--ghost" type="button" data-more hidden>Afficher plus de produits</button></div>
  </div>
</section>

<style>
  .catalog {
    display: grid;
    gap: 1.5rem 3rem;
    padding-block: 2rem clamp(4rem, 8vw, 6rem);
    align-items: start;
  }
  @media (min-width: 1024px) {
    .catalog {
      grid-template-columns: 270px minmax(0, 1fr);
    }
    .filters-toggle {
      display: none;
    }
    .filters {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      max-height: calc(100dvh - var(--header-h) - 3rem);
      overflow-y: auto;
      padding-right: 0.5rem;
    }
  }
  @media (max-width: 1023px) {
    .filters:not([data-open]) {
      display: none;
    }
    .filters {
      padding: 1.25rem;
      background: var(--sand);
      border-radius: var(--radius);
    }
  }
  .filters {
    display: grid;
    gap: 1.4rem;
  }
  .field {
    display: grid;
    gap: 0.5rem;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .field > label,
  legend {
    padding: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  input[type='search'],
  input[type='number'],
  select {
    width: 100%;
    min-height: 46px;
    padding: 0.55rem 0.9rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  input:focus-visible,
  select:focus-visible {
    outline: none;
    border-color: var(--orange);
    box-shadow: 0 0 0 3px rgb(255 126 0 / 0.25);
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .pill span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 38px;
    padding: 0.3rem 0.9rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    background: #fff;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.15s;
  }
  .pill em {
    font-style: normal;
    font-size: 0.75rem;
    color: var(--ink-mute);
  }
  .pill:hover span {
    border-color: var(--navy);
  }
  .pill input:checked + span {
    background: var(--navy-900);
    border-color: var(--navy-900);
    color: #fff;
  }
  .pill input:checked + span em {
    color: var(--on-dark-soft);
  }
  .pill input:focus-visible + span {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
  .range {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.5rem;
    align-items: center;
  }
  .switch {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.95rem;
  }
  .switch input {
    position: absolute;
    opacity: 0;
  }
  .switch__track {
    position: relative;
    width: 44px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--line-strong);
    transition: background-color 0.2s;
  }
  .switch__track::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s;
  }
  .switch input:checked + .switch__track {
    background: var(--orange);
  }
  .switch input:checked + .switch__track::after {
    transform: translateX(18px);
  }
  .switch input:focus-visible + .switch__track {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
  .reset {
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    font-size: 0.875rem;
    text-decoration: underline;
    color: var(--ink-soft);
  }
  .reset:hover {
    color: var(--orange-ink);
  }
  .results__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .results__count {
    color: var(--ink-soft);
  }
  .results__count strong {
    color: var(--navy-900);
    font-size: 1.1rem;
  }
  .sort {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--ink-mute);
  }
  .sort select {
    width: auto;
    min-height: 42px;
  }
  .empty {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    padding: 3rem 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--navy-900);
  }
  .more {
    display: grid;
    justify-items: center;
    margin-top: 3rem;
  }
</style>

<script>
  import { initCatalog } from '../scripts/catalog';
  initCatalog();
</script>
